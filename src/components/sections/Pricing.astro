<section class="container section pricing" id="pricing" data-pricing>
  <div class="section-intro">
    <div>
      <div class="eyebrow"><span /> Pricing</div>
      <h2>Flexible ways<br/>to work together.</h2>
    </div>

    <div class="pricing-note">
      <p>Every project is different. These starting points help you understand where we fit.</p>
      <div class="currency-toggle" aria-label="Choose currency">
        <button class="active" data-currency-button="USD" type="button">USD $</button>
        <button data-currency-button="INR" type="button">INR ₹</button>
      </div>
    </div>
  </div>

  <div class="price-grid">
    <article>
      <span>Starter Build</span>
      <h3><span data-price-starter>$600</span><sup>+</sup></h3>
      <p>Websites, integrations, small AI systems and automation.</p>
      <a class="section-link price-action" href="/#contact">Talk about a starter build <span aria-hidden="true">→</span></a>
    </article>

    <article class="price-featured">
      <span>Custom Development</span>
      <h3>Let’s talk</h3>
      <p>SaaS products, AI platforms and backend systems built around your needs.</p>
      <a class="button section-link" href="/#contact">Start a project <span aria-hidden="true">↗</span></a>
    </article>

    <article>
      <span>Dedicated Engineering</span>
      <h3><span data-price-dedicated>$2.4K</span><sup>+</sup><small data-price-period>/month</small></h3>
      <p>Ongoing product and engineering work for teams that need momentum.</p>
      <a class="section-link price-action" href="/#contact">Explore an engagement <span aria-hidden="true">→</span></a>
    </article>
  </div>
</section>

<script is:inline>
  const root = document.querySelector('[data-pricing]');

  if (root) {
    const starter = root.querySelector('[data-price-starter]');
    const dedicated = root.querySelector('[data-price-dedicated]');
    const period = root.querySelector('[data-price-period]');
    const buttons = root.querySelectorAll('[data-currency-button]');

    const prices = {
      USD: { starter: '$600', dedicated: '$2.4K', period: '/month' },
      INR: { starter: '₹50K', dedicated: '₹2L', period: '/month' },
    };

    const applyCurrency = (currency) => {
      const selected = prices[currency] ? currency : 'USD';
      const values = prices[selected];

      if (starter) starter.textContent = values.starter;
      if (dedicated) dedicated.textContent = values.dedicated;
      if (period) period.textContent = values.period;

      buttons.forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-currency-button') === selected);
      });
    };

    const language = navigator.language || '';
    const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    const defaultCurrency = language.endsWith('-IN') || timeZone === 'Asia/Kolkata' ? 'INR' : 'USD';

    applyCurrency(defaultCurrency);

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const currency = button.getAttribute('data-currency-button') || 'USD';
        applyCurrency(currency);
      });
    });
  }
</script>
